# Креды тестового Telegram-инстанса GREEN-API для локальных и агентских проверок.
# Скопировать в .env.local (gitignored) и заполнить. Приложению они не нужны — в нём креды вводятся на экране входа.
GREEN_API_ID_INSTANCE=
GREEN_API_TOKEN_INSTANCE=
# chatId получателя для живой проверки отправки (числовая строка из checkAccount)
GREEN_API_TEST_CHAT_ID=
# Номер получателя для живой проверки создания чата (только цифры)
GREEN_API_TEST_PHONE=
